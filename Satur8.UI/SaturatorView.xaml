<UserControl x:Class="Satur8.UI.SaturatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aps="clr-namespace:AudioPlugSharpWPF;assembly=AudioPlugSharpWPF"
             mc:Ignorable="d"
             Background="#1E1E1E"
             Width="600"
             Height="400">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PRESETS -->

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">

            <TextBlock Text="PRESETS:"
                       Foreground="White"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,8,0"/>

            <ComboBox Width="160"
                      SelectedIndex="0">

                <ComboBoxItem Content="Default"/>
                <ComboBoxItem Content="Tube Warm"/>
                <ComboBoxItem Content="Aggressive"/>
                <ComboBoxItem Content="Even Heavy"/>

            </ComboBox>

        </StackPanel>

        <!-- MAIN -->

        <UniformGrid Grid.Row="1"
                     Columns="4">

            <!-- DRIVE -->

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="DRIVE"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <aps:Dial
                    Minimum="0.5"
                    Maximum="5.0"
                    DefaultValue="1.0"
                    Value="{Binding DriveValue, Mode=TwoWay}"/>

                <TextBlock Text="{Binding DriveValue, StringFormat=F2}"
                           Foreground="#FFAA33"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <!-- OUTPUT -->

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="OUTPUT"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <aps:Dial
                    Minimum="-20"
                    Maximum="20"
                    DefaultValue="0"
                    Value="{Binding OutputGainValue, Mode=TwoWay}"/>

                <TextBlock Text="{Binding OutputGainValue, StringFormat=F1}"
                           Foreground="#FFAA33"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <!-- EVEN -->

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="EVEN"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <aps:Dial
                    Minimum="0"
                    Maximum="1"
                    DefaultValue="0.5"
                    Value="{Binding EvenAmountValue, Mode=TwoWay}"/>

                <TextBlock Text="{Binding EvenAmountValue, StringFormat=F2}"
                           Foreground="#FFAA33"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <!-- ODD -->

            <StackPanel HorizontalAlignment="Center">

                <TextBlock Text="ODD"
                           Foreground="#AAAAAA"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <aps:Dial
                    Minimum="0"
                    Maximum="1"
                    DefaultValue="1"
                    Value="{Binding OddAmountValue, Mode=TwoWay}"/>

                <TextBlock Text="{Binding OddAmountValue, StringFormat=F2}"
                           Foreground="#FFAA33"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

            </StackPanel>

        </UniformGrid>

    </Grid>

</UserControl>