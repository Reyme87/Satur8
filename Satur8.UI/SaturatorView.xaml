<UserControl x:Class="Satur8.UI.SaturatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Satur8.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="#2C2C2C"
             Width="600" Height="400">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель пресетов -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Stretch">
            <TextBlock Text="PRESETS:" Foreground="White" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"/>
            <ComboBox x:Name="PresetsCombo" Width="150" HorizontalAlignment="Left" 
                      SelectedIndex="0">
                <ComboBoxItem Content="Default" IsSelected="True"/>
                <ComboBoxItem Content="Clean Odd"/>
                <ComboBoxItem Content="Even Heavy"/>
                <ComboBoxItem Content="Tube Warm"/>
                <ComboBoxItem Content="Aggressive Hard"/>
            </ComboBox>
        </StackPanel>

        <!-- Основные элементы управления -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Drive -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                <Label Content="DRIVE" Foreground="White" HorizontalAlignment="Center"/>
                <Slider x:Name="DriveSlider" Orientation="Vertical" Height="120" 
                        Minimum="0.5" Maximum="5.0" Value="{Binding DriveValue, Mode=TwoWay}"
                        TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding DriveValue, StringFormat=F2}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Output -->
            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10" VerticalAlignment="Center">
                <Label Content="OUTPUT" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="120" 
                        Minimum="0.0" Maximum="2.0" Value="{Binding OutputGainValue, Mode=TwoWay}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding OutputGainValue, StringFormat=F2}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Even Amount -->
            <StackPanel Grid.Row="0" Grid.Column="2" Margin="10" VerticalAlignment="Center">
                <Label Content="EVEN" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="120" 
                        Minimum="0.0" Maximum="1.0" Value="{Binding EvenAmountValue, Mode=TwoWay}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding EvenAmountValue, StringFormat=F2}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Odd Amount -->
            <StackPanel Grid.Row="0" Grid.Column="3" Margin="10" VerticalAlignment="Center">
                <Label Content="ODD" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Orientation="Vertical" Height="120" 
                        Minimum="0.0" Maximum="1.0" Value="{Binding OddAmountValue, Mode=TwoWay}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding OddAmountValue, StringFormat=F2}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bias -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
                <Label Content="BIAS" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Minimum="-0.5" Maximum="0.5" Value="{Binding BiasValue, Mode=TwoWay}"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding BiasValue, StringFormat=F2}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Clip Type -->
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                <Label Content="CLIP TYPE" Foreground="White" HorizontalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding ClipTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Hard"/>
                    <ComboBoxItem Content="Soft"/>
                    <ComboBoxItem Content="Tube (Tanh)"/>
                    <ComboBoxItem Content="Arctan"/>
                </ComboBox>
            </StackPanel>

            <!-- Mix (Dry/Wet) -->
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="10">
                <Label Content="MIX" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Minimum="0" Maximum="100" Value="{Binding MixPercent, Mode=TwoWay}"
                        TickFrequency="10" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding MixPercent, StringFormat={}{0:F0}%}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Dynamics - простой компрессор Threshold -->
            <StackPanel Grid.Row="1" Grid.Column="3" Margin="10">
                <Label Content="THRESHOLD (dB)" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Minimum="-30" Maximum="0" Value="{Binding ThresholdDb, Mode=TwoWay}"
                        TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding ThresholdDb, StringFormat={}{0:F0} dB}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Dynamics Ratio -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="10">
                <Label Content="RATIO" Foreground="White" HorizontalAlignment="Center"/>
                <Slider Minimum="1" Maximum="10" Value="{Binding RatioValue, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding RatioValue, StringFormat=F1}" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Auto Gain -->
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
                <Label Content="AUTO GAIN" Foreground="White" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding AutoGainEnabled, Mode=TwoWay}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
