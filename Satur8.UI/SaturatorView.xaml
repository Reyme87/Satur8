<UserControl x:Class="Satur8.UI.SaturatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:aps="clr-namespace:AudioPlugSharpWPF;assembly=AudioPlugSharpWPF"
             xmlns:conv="clr-namespace:Satur8.UI.Converters"
             mc:Ignorable="d"
             Focusable="True"
             FocusManager.IsFocusScope="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <conv:InverseBoolConverter        x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Viewbox Stretch="Uniform" StretchDirection="Both">
            <Grid Width="640" Height="420"
                  Background="{StaticResource BackgroundBrush}">

                <!-- ===== ОСНОВНОЙ ИНТЕРФЕЙС ===== -->
                <Grid Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP BAR -->
                    <DockPanel Grid.Row="0" VerticalAlignment="Center">

                        <!-- Правые элементы — ⚙ Account -->
                        <Button Style="{StaticResource IconButton}"
                                Height="26" Width="26" FontSize="14"
                                DockPanel.Dock="Right" Margin="0,0,0,0"
                                Click="AccountButton_Click">
                            <TextBlock Text="⚙" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- SAVE -->
                        <Button Style="{StaticResource SaveButton}"
                                Height="26" DockPanel.Dock="Right" Margin="0,0,4,0"
                                Click="SavePresetButton_Click">
                            <TextBlock Text="SAVE" FontSize="10" FontWeight="Bold"/>
                        </Button>

                        <!-- ★ Избранное -->
                        <ToggleButton Style="{StaticResource FavouriteToggle}"
                                      Content="★" Height="26" Width="26"
                                      FontSize="13" FontWeight="Bold"
                                      DockPanel.Dock="Right" Margin="0,0,4,0"
                                      IsChecked="{Binding ShowFavouritesOnly, Mode=TwoWay}"/>

                        <!-- Список пресетов -->
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  Height="26" Width="130"
                                  DockPanel.Dock="Right" Margin="0,0,4,0"
                                  ItemsSource="{Binding FilteredPresets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  SelectionChanged="PresetList_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right"
                                                Tag="{Binding PresetId}"
                                                Width="16" Height="16"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="FavouriteButton_Click"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content"    Value="☆"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                                                    <Setter Property="FontSize"   Value="10"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                                                            <Setter Property="Content"    Value="★"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CategoryName}"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       FontSize="9"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Заголовок -->
                        <TextBlock Text="SATUR8"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" FontSize="20"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left" Margin="0,0,8,0"/>
                        <TextBlock Text="v1.0"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   FontSize="10" VerticalAlignment="Center"
                                   Margin="0,3,0,0"/>
                    </DockPanel>

                    <!-- Линия под топ-баром -->
                    <Rectangle Grid.Row="0" Height="1"
                               Fill="{StaticResource SeparatorBrush}"
                               VerticalAlignment="Bottom"/>

                    <!-- ROW 1: Drive / Output / Even / Odd -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="DRIVE" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="0.5" Maximum="5.0" DefaultValue="1.0"
                                      Value="{Binding DriveValue, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DriveValue, StringFormat={}{0:F2}}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Style="{StaticResource SectionSeparator}"/>

                        <StackPanel Grid.Column="2" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="OUTPUT" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="-20" Maximum="20" DefaultValue="0"
                                      Value="{Binding OutputGainValue, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OutputGainValue, StringFormat={}{0:F1} dB}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Style="{StaticResource SectionSeparator}"/>

                        <StackPanel Grid.Column="4" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="EVEN" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="0" Maximum="1" DefaultValue="0.5"
                                      Value="{Binding EvenAmountValue, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding EvenAmountValue, StringFormat={}{0:F2}}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Style="{StaticResource SectionSeparator}"/>

                        <StackPanel Grid.Column="6" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="ODD" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="0" Maximum="1" DefaultValue="1"
                                      Value="{Binding OddAmountValue, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding OddAmountValue, StringFormat={}{0:F2}}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Линия между рядами -->
                    <Rectangle Grid.Row="1" Height="1"
                               Fill="{StaticResource SeparatorBrush}"
                               VerticalAlignment="Bottom"/>

                    <!-- ROW 2: Bias / Mix / Threshold / Clip Type -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="BIAS" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="-0.5" Maximum="0.5" DefaultValue="0"
                                      Value="{Binding BiasValue, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding BiasValue, StringFormat={}{0:F2}}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Style="{StaticResource SectionSeparator}"/>

                        <StackPanel Grid.Column="2" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="MIX" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="0" Maximum="100" DefaultValue="100"
                                      Value="{Binding MixPercent, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding MixPercent, StringFormat={}{0:F0}%}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="3" Style="{StaticResource SectionSeparator}"/>

                        <StackPanel Grid.Column="4" Style="{StaticResource KnobPanel}">
                            <TextBlock Text="THRESHOLD" Style="{StaticResource KnobLabel}"/>
                            <aps:Dial Width="80" Height="80"
                                      Minimum="-30" Maximum="0" DefaultValue="-12"
                                      Value="{Binding ThresholdDb, Mode=TwoWay}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ThresholdDb, StringFormat={}{0:F0} dB}"
                                       Style="{StaticResource KnobValue}"/>
                        </StackPanel>

                        <Rectangle Grid.Column="5" Style="{StaticResource SectionSeparator}"/>

                        <!-- CLIP TYPE вместо RATIO -->
                        <StackPanel Grid.Column="6" Style="{StaticResource KnobPanel}"
                                    VerticalAlignment="Center">
                            <TextBlock Text="CLIP TYPE" Style="{StaticResource KnobLabel}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      Height="30" Margin="0,8,0,0"
                                      SelectedIndex="{Binding ClipTypeIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Soft"/>
                                <ComboBoxItem Content="Hard"/>
                                <ComboBoxItem Content="Tube"/>
                                <ComboBoxItem Content="Arctan"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                </Grid>

                <!-- ===== SAVE PRESET OVERLAY ===== -->
                <Grid Background="{StaticResource ModalOverlayBrush}"
                      Visibility="{Binding ShowSavePanel,
                                   Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource OverlayPanel}">
                        <StackPanel>

                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="SAVE PRESET"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button Content="← BACK"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="26" FontSize="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="CloseSavePanel_Click"/>
                            </Grid>

                            <Border Style="{StaticResource ErrorBorder}"
                                    Visibility="{Binding SaveError,
                                                 Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding SaveError}"
                                           Foreground="{StaticResource ErrorTextBrush}"
                                           FontSize="10" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="PRESET NAME" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="PresetNameBox"
                                     Style="{StaticResource DarkInput}"
                                     Text="{Binding NewPresetName, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="DESCRIPTION (необязательно)"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource DarkInput}"
                                     Text="{Binding NewPresetDesc, Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource DarkComboBox}"
                                      IsEditable="True"
                                      Text="{Binding NewPresetCategory, Mode=TwoWay,
                                             UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding Categories}"
                                      Height="34" Margin="0,0,0,22"/>

                            <Button Content="SAVE PRESET"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding IsLoading,
                                                Converter={StaticResource InverseBoolConverter}}"
                                    Click="ConfirmSavePreset_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== ACCOUNT OVERLAY ===== -->
                <Grid Background="{StaticResource ModalOverlayBrush}"
                      Visibility="{Binding ShowAccountPanel,
                                   Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Style="{StaticResource OverlayPanel}">
                        <StackPanel>

                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="ACCOUNT"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Button Content="← BACK"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="26" FontSize="10"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="CloseAccountPanel_Click"/>
                            </Grid>

                            <!-- Форма входа -->
                            <StackPanel Visibility="{Binding ShowLoginForm,
                                        Converter={StaticResource BoolToVisibilityConverter}}">

                                <Border Style="{StaticResource ErrorBorder}"
                                        Visibility="{Binding AuthError,
                                                     Converter={StaticResource StringToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AuthError}"
                                               Foreground="{StaticResource ErrorTextBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="LOGIN" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="LoginBox"
                                         Style="{StaticResource DarkInput}"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource DarkPassword}"
                                             Margin="0,0,0,22"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="LOG IN"
                                            Style="{StaticResource PrimaryButton}"
                                            IsEnabled="{Binding IsLoading,
                                                        Converter={StaticResource InverseBoolConverter}}"
                                            Click="LoginButton_Click"/>
                                    <Button Grid.Column="2" Content="REGISTER"
                                            Style="{StaticResource SecondaryButton}"
                                            IsEnabled="{Binding IsLoading,
                                                        Converter={StaticResource InverseBoolConverter}}"
                                            Click="RegisterButton_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Профиль -->
                            <StackPanel Visibility="{Binding ShowProfilePanel,
                                        Converter={StaticResource BoolToVisibilityConverter}}">

                                <TextBlock Text="{Binding LoggedInAs}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,24"/>

                                <Button Content="LOG OUT"
                                        Style="{StaticResource LogoutButton}"
                                        Click="LogoutButton_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
