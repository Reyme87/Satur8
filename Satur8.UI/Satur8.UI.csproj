	<Target Name="DeployVST3" AfterTargets="Build">

		<MakeDir Directories="$(VstOutputDir)" />

		<Copy SourceFiles="$(NuGetPackageRoot)audioplugsharpvst3\0.7.9\contentFiles\vst\AudioPlugSharpVst.vst3" DestinationFiles="$(VstOutputDir)\$(VstPluginName).vst3" />

		<Copy SourceFiles="$(NuGetPackageRoot)audioplugsharpvst3\0.7.9\contentFiles\vst\AudioPlugSharpVst.runtimeconfig.json" DestinationFiles="$(VstOutputDir)\$(VstPluginName).runtimeconfig.json" />

		<ItemGroup>
			<PluginFiles Include="$(OutDir)\*.dll" />
			<PluginFiles Include="$(OutDir)\*.json" />
		</ItemGroup>

		<Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(VstOutputDir)" SkipUnchangedFiles="true" />

	</Target>

</Project>
